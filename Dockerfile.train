# =============================================================================
# Dockerfile.train
# Image Docker pour le fine-tuning Whisper avec GPU CUDA.
#
# Base : pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime
#   → PyTorch 2.1, CUDA 12.1, cuDNN 8 pré-installés
#   → Image "runtime" (plus légère que "devel", pas de compilateur CUDA)
# =============================================================================

FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

# Métadonnées de l'image
LABEL maintainer="Akilang Project"
LABEL description="Fine-tuning Whisper Fulfuldé avec LoRA, MLflow et Hydra"
LABEL version="1.0"

# Répertoire de travail dans le conteneur
WORKDIR /app

# --- Installation des dépendances système ---
# ffmpeg : décodage audio (wav, mp3, flac, ogg, etc.) requis par torchaudio et librosa
# git    : requis par certains packages Python installés depuis GitHub
# Empêche les invites interactives pendant l'installation
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

# --- Installation des dépendances Python ---
# On copie requirements.txt en premier pour profiter du cache des couches Docker
# (si les requirements ne changent pas, cette couche n'est pas reconstruite)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- Copie du code source ---
# Copier après l'installation des deps pour maximiser l'utilisation du cache
COPY . .

# --- Sécurité : utilisateur non-root ---
# Bonne pratique pour éviter d'exécuter le conteneur en tant que root
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

# Point d'entrée : lance l'entraînement avec Hydra
# Les arguments supplémentaires (overrides Hydra) sont passés via docker-compose command:
ENTRYPOINT ["python", "src/training/train.py"]
